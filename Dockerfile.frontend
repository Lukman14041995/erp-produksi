# syntax=docker/dockerfile:1
#
# Multi-stage build for the Vite/React SPA. Build context is the repo root
# (so this can COPY from web/), producing a static bundle served by nginx,
# which also reverse-proxies /api/v1 to the backend container -- putting
# both behind one origin in production, which sidesteps CORS entirely for
# real browser traffic (CORS_ALLOWED_ORIGINS on the backend still matters
# for direct API access, e.g. a separately hosted admin tool).

# ---- Build stage ----
FROM node:20-alpine AS builder

WORKDIR /app

COPY web/package.json web/package-lock.json ./
RUN npm ci

COPY web/ .

# Vite inlines VITE_* vars at build time, not runtime -- a relative path
# here means the browser calls the same origin nginx serves the SPA from,
# which nginx then proxies to the backend (see nginx.conf).
ARG VITE_API_URL=/api/v1
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

# ---- Runtime stage ----
FROM nginx:alpine AS runtime

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY security-headers.conf /etc/nginx/security-headers.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=5 \
    CMD wget -qO- http://127.0.0.1:80/ || exit 1
