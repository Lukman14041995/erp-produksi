# Copy to .env and adjust for local development.
# docker-compose.yml reads this file automatically.

# ---- Postgres ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=clothing_erp
POSTGRES_PORT=5432

# ---- Backend ----
APP_ENV=development
# Generate with: openssl rand -base64 48
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
# Comma-separated list of allowed browser origins for direct (non-proxied) API calls.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5174
LOG_LEVEL=info
BACKEND_PORT=8099

# ---- Frontend ----
FRONTEND_PORT=8080
