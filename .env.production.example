# Copy to .env on the production host and fill in real values before running:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# Never commit the real .env. Treat JWT_SECRET and POSTGRES_PASSWORD as
# secrets — pull them from your secret manager (e.g. `openssl rand -base64
# 48` for JWT_SECRET) rather than typing memorable values.

# ---- Postgres ----
POSTGRES_USER=clothing_erp
POSTGRES_PASSWORD=__REPLACE_WITH_A_STRONG_RANDOM_PASSWORD__
POSTGRES_DB=clothing_erp
# Not published to the host under docker-compose.prod.yml; left here only
# for reference if you ever need to flip that back on for a one-off psql session.
POSTGRES_PORT=5432

# ---- Backend ----
APP_ENV=production
JWT_SECRET=__REPLACE_WITH_OPENSSL_RAND_BASE64_48__
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
# The real domain(s) that serve the frontend. Same-origin traffic through
# nginx's reverse proxy doesn't need this, but keep it correct for anyone
# calling the API directly (mobile app, admin CLI, etc).
CORS_ALLOWED_ORIGINS=https://erp.example.com
LOG_LEVEL=warn
BACKEND_PORT=8099

# ---- Frontend ----
# nginx.conf only terminates plain HTTP. Put a TLS-terminating load balancer
# or reverse proxy (cloud LB, Cloudflare, a Caddy/Traefik sidecar) in front
# of this port for real traffic -- this compose setup does not manage
# certificates.
FRONTEND_PORT=8080
